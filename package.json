{
  "name": "hub-de-leitura-teste-ui",
  "version": "1.0.0",
  "description": "Este projeto trata-se de um teste de UI para o Hub de Leitura da EBAC.",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress run --browser chrome",
    "report:merge": "npx mochawesome-merge \"cypress/results/mochawesome*.json\" -o cypress/results/merged.json",
    "report:generate": "npx marge cypress/results/merged.json -f index -o cypress/report",
    "report": "npm run report:merge && npm run report:generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EBAC-QE/hub-de-leitura-teste-ui.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/EBAC-QE/hub-de-leitura-teste-ui/issues"
  },
  "homepage": "https://github.com/EBAC-QE/hub-de-leitura-teste-ui#readme",
  "dependencies": {
    "@faker-js/faker": "^10.2.0",
    "cypress": "^15.9.0"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
